[configuration]

entry_symbol = "ffmpeg_init"
compatibility_minimum = "4.7"  ; bindings generated for the Godot 4.7 API (godot-cpp master, api_version=4.7)

[libraries]

windows.debug.x86_64 = "res://addons/ffmpeg/win64/libgdffmpeg.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/ffmpeg/win64/libgdffmpeg.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://addons/ffmpeg/linux64/libgdffmpeg.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/ffmpeg/linux64/libgdffmpeg.linux.template_release.x86_64.so"
macos.debug = "res://addons/ffmpeg/macos/libgdffmpeg.macos.template_debug.universal.dylib"
macos.release = "res://addons/ffmpeg/macos/libgdffmpeg.macos.template_release.universal.dylib"

; EIRTeam.FFmpeg (MIT) built by this repo against the FFmpeg 6.1 LGPL
; libraries. Every FFmpeg shared library ships inside the addon:
; - windows: no rpath, DLLs are copied next to the exported executable
;   (generated windows.x86_64 list below)
; - linux: RUNPATH=$ORIGIN, FFmpeg .so files next to the extension
; - macOS: @rpath install names, universal dylibs exported to
;   Contents/Frameworks
[dependencies]

; windows dependencies are generated by tools/windows-bundle.py (dist snippet).
; the static list below is the shipped win64 set from the upstream release.
windows.x86_64 = {
	"res://addons/ffmpeg/win64/avcodec-60.dll": "",
	"res://addons/ffmpeg/win64/avfilter-9.dll": "",
	"res://addons/ffmpeg/win64/avformat-60.dll": "",
	"res://addons/ffmpeg/win64/avutil-58.dll": "",
	"res://addons/ffmpeg/win64/swresample-4.dll": "",
	"res://addons/ffmpeg/win64/swscale-7.dll": "",
}
; macos dependencies are generated by tools/macos-bundle.sh (dist snippet).
; linux dependencies are generated by tools/linux-bundle.sh (dist snippet).
