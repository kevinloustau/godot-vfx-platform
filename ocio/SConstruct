#!/usr/bin/env python
# GDExtension build: OpenColorIO + OpenImageIO for Godot 4.
#
# Usage (from this directory, godot-cpp submodule checked out at the repo
# root next to this folder):
#   scons target=template_debug          # godot-cpp is built on demand
#   scons target=template_release
#   scons arch=arm64                     # macOS arch (arm64 / x86_64; the
#                                        # bundle script lipo-merges into
#                                        # .universal.dylib)
#   scons rpath=0                        # no -rpath to the brew libdir
#                                        # (portable/bundled builds)
#   scons install=0                      # skip copying into dist/ocio
#
# Dependencies (pkg-config): OpenColorIO >= 2.1, OpenImageIO >= 2.2.
# Override with OCIO_CFLAGS/OCIO_LIBS and OIIO_CFLAGS/OIIO_LIBS env vars.

import os
import subprocess
import sys

env = Environment()

godot_cpp = ARGUMENTS.get("godot_cpp", os.path.join("..", "godot-cpp"))
if not os.path.isdir(godot_cpp):
	print("godot-cpp not found at '%s' (git submodule update --init, or pass godot_cpp=...)" % godot_cpp)
	Exit(1)
# godot-cpp v10 (master) picks the engine API with api_version; older
# godot-cpp releases (<= 4.5 branch) ignore it and build their own API.
api_version = ARGUMENTS.get("api_version", "4.7")
SConscript(godot_cpp + "/SConstruct", {"env": env, "api_version": api_version}, duplicate=False)

env.Append(CPPPATH=["src/"])


def try_pkg(args):
	try:
		return subprocess.check_output(args).decode().strip().split()
	except (subprocess.CalledProcessError, OSError):
		return None


# godot-cpp compiles with -fno-exceptions; OpenColorIO API needs exceptions
# (only our own sources are compiled after this line). MSVC has them on by
# default and rejects GCC-style flags.
is_msvc = env["platform"] == "windows" and not int(ARGUMENTS.get("use_mingw", "0"))
if not is_msvc:
	env.Append(CCFLAGS=["-fexceptions"])

# pkg-config is the default; OCIO_CFLAGS/OCIO_LIBS/OIIO_CFLAGS/OIIO_LIBS
# env vars override it (Windows: point them at your vcpkg/OCIO build).
def apply_include_flags(flags):
	# cl (MSVC) accepts both -I<path> and -I <path>, but scons/MSVC tooling
	# here gets -I split from its path (Github runner spaces); always emit
	# the attached /I form on MSVC.
	for f in flags:
		if f.startswith("-I"):
			path = f[2:]
			if not path:
				continue
			env.AppendUnique(CPPPATH=[path])


def apply_lib_flags(flags):
	# -L/-l must go to LIBPATH/LIBS: SCons puts LINKFLAGS *before* the object
	# files, and with -Wl,--as-needed (the Ubuntu default) libraries listed
	# there are dropped, leaving undefined symbols and no DT_NEEDED entry.
	extra = []
	for f in flags:
		if f.startswith("-L"):
			env.AppendUnique(LIBPATH=[f[2:]])
		elif f.startswith("-l"):
			env.AppendUnique(LIBS=[f[2:]])
		else:
			extra.append(f)
	if extra:
		env.Append(LINKFLAGS=extra)


apply_include_flags(os.environ.get("OCIO_CFLAGS", "").split())
apply_include_flags(os.environ.get("OIIO_CFLAGS", "").split())
apply_lib_flags(os.environ.get("OCIO_LIBS", "").split())
apply_lib_flags(os.environ.get("OIIO_LIBS", "").split())
use_pkg = not (os.environ.get("OCIO_CFLAGS") and os.environ.get("OCIO_LIBS")
		and os.environ.get("OIIO_CFLAGS") and os.environ.get("OIIO_LIBS"))

for name, lib in (("OpenColorIO", "OCIO"), ("OpenImageIO", "OIIO")):
	if not use_pkg:
		break
	cflags = try_pkg(["pkg-config", "--cflags", name])
	libs = try_pkg(["pkg-config", "--libs", name])
	if cflags is None or libs is None:
		print("pkg-config cannot find %s (needed by the OCIO extension)" % name)
		Exit(1)
	apply_include_flags(cflags)
	apply_lib_flags(libs)
	libdir = try_pkg(["pkg-config", "--variable=libdir", name])
	if libdir and env["platform"] != "windows":
		# runtime location of libOpenColorIO/libOpenImageIO for the loaded .so;
		# rpath=0 skips it for portable/bundled builds (RUNPATH=$ORIGIN)
		if int(ARGUMENTS.get("rpath", "1")):
			env.Append(LINKFLAGS=["-Wl,-rpath," + libdir[0]])
		# Transitive deps (e.g. fmt) live in the shared prefix include dir
		# (e.g. Homebrew), which the .pc file does not propagate. Needed
		# for compiling regardless of rpath.
		p = os.path.dirname(libdir[0])
		for _ in range(6):  # Cellar/<formula>/<ver>/lib → shared prefix include
			cand = os.path.join(p, "include")
			if os.path.isdir(cand) and cand not in env["CPPPATH"]:
				env.Append(CPPPATH=[cand])
			p = os.path.dirname(p)
if not use_pkg:
	env.AppendUnique(CPPPATH=[p[2:] for p in os.environ.get("OCIO_CFLAGS", "").split()
			+ os.environ.get("OIIO_CFLAGS", "").split() if p.startswith("-I")])


# OCIO 2.2+ deprecates some 2.1 APIs we use.
env.Append(CCFLAGS=["/wd4996"] if is_msvc else ["-Wno-deprecated-declarations"])

if env["platform"] == "linux":
	# Fail the link on unresolved symbols. A shared library links fine with
	# undefined symbols by default, which silently produced an extension that
	# could not dlopen (e.g. when --as-needed dropped the -l flags).
	env.Append(LINKFLAGS=["-Wl,--no-undefined"])

if env["platform"] == "macos":
	# Portable bundle: tools/macos-bundle.sh rewrites the dependency install
	# names to @rpath/<name>. @loader_path resolves them next to the library
	# (editor), @executable_path/../Frameworks is where Godot's macOS export
	# places them. headerpad leaves room for install_name_tool edits.
	# The install name (LC_ID_DYLIB) is the final universal name, so the
	# merged binary describes itself correctly.
	env.Append(LINKFLAGS=["-Wl,-headerpad_max_install_names",
			"-Wl,-install_name,@rpath/libgdocio.macos.%s.universal.dylib" % env["target"],
			"-Wl,-rpath,@loader_path",
			"-Wl,-rpath,@executable_path/../Frameworks"])

sources = Glob("src/*.cpp")
# Plain dylib on every platform. The macOS arch-tagged names are lipo-merged
# into libgdocio.macos.<target>.universal.dylib by tools/macos-bundle.sh.
suffix = ".{}.{}.{}{}".format(
	env["platform"],
	env["target"],
	env["arch"],
	env["SHLIBSUFFIX"])
library = env.SharedLibrary("libgdocio{}".format(suffix), source=sources)
Default(library)  # with install=0 this is still the default target

# Install: binary + descriptor into dist/ocio/<platform>/ at the repo root.
# This is a build/distribution repo (not a Godot project): copy the result
# into <project>/addons/ocio/ to use it, as described in ocio/README.md.
dist = os.path.join("..", "dist", "ocio")
platform_dir = {"linux": "linux64", "windows": "win64", "macos": "macos"}.get(env["platform"])
if platform_dir and int(ARGUMENTS.get("install", "1")):
	installs = [env.Install(os.path.join(dist, platform_dir), library),
			env.Install(dist, "ocio.gdextension")]
	Default(installs)
