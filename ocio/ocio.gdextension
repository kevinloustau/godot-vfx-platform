[configuration]

entry_symbol = "ocio_init"
compatibility_minimum = "4.7"  ; bindings generated for the Godot 4.7 API (godot-cpp master, api_version=4.7)

[libraries]

linux.debug.x86_64 = "res://addons/ocio/linux64/libgdocio.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://addons/ocio/linux64/libgdocio.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://addons/ocio/win64/libgdocio.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/ocio/win64/libgdocio.windows.template_release.x86_64.dll"
macos.debug = "res://addons/ocio/macos/libgdocio.macos.template_debug.universal.dylib"
macos.release = "res://addons/ocio/macos/libgdocio.macos.template_release.universal.dylib"

; Runtime DLLs the cross-built Windows .dll needs (native/ocio/docker/,
; build-windows.sh). Regenerated by the build: win64/dependencies-snippet.txt.
; OCIO/OIIO are linkable from the loader path on Linux; for portable
; exports there, bundle the shared libs the same way or link them static.
;
; macOS: universal dylibs bundled next to the library by tools/macos-bundle.sh,
; install names rewritten to @rpath, listed below for the editor preload and
; the macOS export (Contents/Frameworks).
[dependencies]

windows.x86_64 = {
	"res://addons/ocio/win64/libbz2-1.dll": "",
	"res://addons/ocio/win64/libc++.dll": "",
	"res://addons/ocio/win64/libcrypto-3-x64.dll": "",
	"res://addons/ocio/win64/libdeflate.dll": "",
	"res://addons/ocio/win64/libexpat-1.dll": "",
	"res://addons/ocio/win64/libIex-3_5.dll": "",
	"res://addons/ocio/win64/libIlmThread-3_5.dll": "",
	"res://addons/ocio/win64/libImath-3_2.dll": "",
	"res://addons/ocio/win64/libjbig-0.dll": "",
	"res://addons/ocio/win64/libjpeg-8.dll": "",
	"res://addons/ocio/win64/libLerc.dll": "",
	"res://addons/ocio/win64/liblzma-5.dll": "",
	"res://addons/ocio/win64/libminizip-ng-1.dll": "",
	"res://addons/ocio/win64/libOpenColorIO_2_6.dll": "",
	"res://addons/ocio/win64/libOpenEXR-3_5.dll": "",
	"res://addons/ocio/win64/libOpenEXRCore-3_5.dll": "",
	"res://addons/ocio/win64/libOpenImageIO.dll": "",
	"res://addons/ocio/win64/libOpenImageIO_Util.dll": "",
	"res://addons/ocio/win64/libopenjph-0.32.dll": "",
	"res://addons/ocio/win64/libpng16-16.dll": "",
	"res://addons/ocio/win64/libsharpyuv-0.dll": "",
	"res://addons/ocio/win64/libtiff-6.dll": "",
	"res://addons/ocio/win64/libunwind.dll": "",
	"res://addons/ocio/win64/libwebp-7.dll": "",
	"res://addons/ocio/win64/libwinpthread-1.dll": "",
	"res://addons/ocio/win64/libyaml-cpp.dll": "",
	"res://addons/ocio/win64/libzstd.dll": "",
	"res://addons/ocio/win64/zlib1.dll": "",
}
; macos dependencies are generated by tools/macos-bundle.sh (dist snippet).
; linux dependencies are generated by tools/linux-bundle.sh (dist snippet).
